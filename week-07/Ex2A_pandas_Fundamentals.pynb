   "source": [
    "df1.insert(3, \"ser4\", ser4)\n",
    "df1\n",
    "\n",
    "# ser4 came from a dictionary, so its index uses labels like\n",
    "# 'first', 'second', 'third', and 'fourth' instead of numeric indexes 0,1,2,3.\n",
    "# Because of that, pandas aligns by index label, which causes missing values (NaN)\n",
    "# where the labels do not match the numeric row indexes in df1.\n"
   ]
